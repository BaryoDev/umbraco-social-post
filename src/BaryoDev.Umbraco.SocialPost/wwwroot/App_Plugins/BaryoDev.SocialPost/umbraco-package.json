{
  "$schema": "../../umbraco-package-schema.json",
  "name": "BaryoDev.Umbraco.SocialPost",
  "version": "0.1.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "BaryoDev.SocialPost.Dashboard",
      "name": "Social post",
      "element": "/App_Plugins/BaryoDev.SocialPost/social-post-dashboard.js",
      "weight": -10,
      "meta": {
        "label": "Social post",
        "pathname": "social-post"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    }
  ]
}
